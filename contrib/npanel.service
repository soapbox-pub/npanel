# npanel under systemd, for the release binary. See docs/deployment.md.
#
# Expects /usr/local/bin/npanel, an `npanel` system user, and its
# configuration in /etc/npanel/npanel.toml with data_dir set to /var/lib/npanel.

[Unit]
Description=npanel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=npanel
Group=npanel
ExecStart=/usr/local/bin/npanel --config /etc/npanel/npanel.toml
Restart=on-failure
RestartSec=5s

# Logs are one JSON object per line on stdout.
StandardOutput=journal
StandardError=journal

# With https_port set, npanel binds 80 and 443 itself, which needs this.
#AmbientCapabilities=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/npanel

[Install]
WantedBy=multi-user.target
