{
  "name": "npanel",
  "version": "0.1.0",
  "description": "Self-hostable nsite gateway with a team dashboard",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,dashboard -c blue,magenta \"bun run dev:server\" \"bun run dashboard:dev\"",
    "dev:server": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "lint": "biome check",
    "check": "tsc --noEmit",
    "make-admin": "bun run scripts/make-admin.ts",
    "prune-blobs": "bun run scripts/prune-blobs.ts",
    "compress-blobs": "bun run scripts/compress-blobs.ts",
    "dashboard:install": "cd dashboard && bun install",
    "dashboard:dev": "cd dashboard && bun run dev",
    "dashboard:build": "cd dashboard && bun run build",
    "dashboard:test": "cd dashboard && bun run test"
  },
  "dependencies": {
    "@nostrify/nostrify": "^0.54.0",
    "entities": "^8.0.0",
    "hono": "^4.13.1",
    "kysely": "^0.29.5",
    "node-html-parser": "^9.0.1",
    "nostr-tools": "^2.24.1",
    "tldts": "^7.4.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.0.10",
    "concurrently": "^10.0.5",
    "typescript": "^5.7.3"
  }
}
