# Sample Caddyfile for npanel.
#
# npanel speaks plain HTTP and routes on the Host header. Caddy terminates TLS
# and forwards everything to it. Because staff add hostnames at runtime, the
# certificate for a site can't be known when Caddy starts — so this uses
# on-demand TLS, with npanel itself deciding which names deserve a certificate.
#
# The placeholders below are Caddy's environment variables, not npanel's, and
# take their defaults from a Caddy installed on the same host as npanel.
# compose.yaml sets them instead, so the same file works for a container
# install; edit them in place if you'd rather not use them at all.

{
	# Caddy asks npanel before issuing any certificate. npanel answers 200 for
	# the dashboard hostname and for every enabled host, 404 for anything else.
	# Without this guard, anyone pointing a domain at the box could make Caddy
	# request certificates on their behalf.
	#
	# The request arrives with no hostname npanel could route on, so this is a
	# second port rather than a path on the one below — answering it on the
	# public listener would mean answering it on every site npanel serves, and
	# a stranger could then spend a configured host's certificate budget. Newer
	# Caddy versions spell this `permission http http://.../tls-check`.
	on_demand_tls {
		ask http://{$NPANEL_TLS_CHECK:127.0.0.1:3001}/tls-check
	}

	# email you@example.com
}

# The dashboard. Its certificate is issued at startup like a normal site.
{$DASHBOARD_HOST:panel.example.com} {
	# For the API's JSON. npanel sends the dashboard's own files already
	# compressed, and Caddy leaves those as they are.
	encode zstd gzip
	reverse_proxy {$NPANEL_UPSTREAM:127.0.0.1:3000}
}

# Every other hostname pointed at this box, served as an nsite.
https:// {
	tls {
		on_demand
	}

	# No `encode` here on purpose. npanel compresses a site's files when it
	# downloads them and serves whichever copy the visitor can read, so there
	# is nothing left for Caddy to do — and doing it here would only ever
	# reach visitors arriving through Caddy, which leaves out everyone on a
	# site's onion address.
	#
	# If you are upgrading an npanel that has been running, compress what it
	# already downloaded before you take this directive out, or the sites it
	# is serving go back to shipping raw HTML until they next deploy:
	#
	#     npanel compress-blobs

	reverse_proxy {$NPANEL_UPSTREAM:127.0.0.1:3000}
}
