# Built inside the image. Every Cargo target directory, the vendored crate's
# included: a pattern without `**/` matches only at the root.
**/target/
dashboard/node_modules/
dashboard/dist/

# Host state, which must never end up in a layer: the development config,
# compose's variables, and the data directory.
npanel.toml
.env
.env.*
data/

.git/
docs/
*.md
Dockerfile
.dockerignore
compose.yaml
