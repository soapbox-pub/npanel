# Built inside the image. Every Cargo target directory, the vendored crate's
# included: a pattern without `**/` matches only at the root.
**/target/
dashboard/node_modules/
dashboard/dist/

# Host state and secrets, which must never end up in a layer: npanel loads .env
# from its working directory, so a copied one would silently override the
# environment compose passes in.
.env
.env.*
!.env.example
data/

.git/
docs/
*.md
Dockerfile
.dockerignore
compose.yaml
