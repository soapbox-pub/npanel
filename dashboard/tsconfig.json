{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,

    /* Linting */
    "strict": true,

    /* Incremental compilation for faster re-runs of `tsc --noEmit` */
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"],
      "@shared/nsite-address": ["./src/shared/nsite-address.ts"],
      "@shared/pubkey": ["./src/shared/pubkey.ts"],
      "@shared/hostname": ["./src/shared/hostname.ts"],
      "@shared/nip05": ["./src/shared/nip05.ts"],
      "@shared/relay-url": ["./src/shared/relay-url.ts"],
      "@shared/env": ["./src/shared/env.ts"],
      "@shared/analytics-query": ["./src/shared/analytics-query/parse.ts"]
    }
  },
  "include": ["src"]
}
