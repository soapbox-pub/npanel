# npanel configuration
#
# These seven variables are the entire file-based configuration. Everything else
# (relays, Blossom fallbacks, file size limits, resync interval) is configured by
# an admin from the dashboard and stored in the database.

# Port the HTTP server listens on. The reverse proxy forwards to this.
PORT="3000"

# Address the HTTP server listens on. Loopback by default: npanel is meant to be
# reachable only by the reverse proxy. Set 0.0.0.0 if the proxy is on another
# machine, and firewall the port.
BIND_ADDRESS="127.0.0.1"

# Port answering the reverse proxy's certificate questions, on BIND_ADDRESS.
# Separate from PORT because the proxy asks without a hostname to route on, so
# on the public port the answer would be reachable through every site npanel
# serves. Only the proxy should be able to reach it.
TLS_CHECK_PORT="3001"

# Serve HTTPS on this port without a proxy, with a certificate from Let's
# Encrypt for every site, renewed on its own. Setting it agrees to the
# certificate authority's terms of service. Use 443, with PORT="80" for the
# challenges and the redirect to HTTPS; BIND_ADDRESS then defaults to every
# address, and TLS_CHECK_PORT isn't used. See docs/deployment.md.
# HTTPS_PORT="443"

# Hostname that serves the dashboard and the JSON API. Requests arriving with
# any other Host header are served as nsites. Use "localhost" for local
# development; see docs/development.md.
DASHBOARD_HOST="panel.example.com"

# One of: debug, info, warn, error
LOG_LEVEL="info"

# Directory holding npanel.sqlite3 and the content-addressed blob store.
DATA_DIR="./data"
